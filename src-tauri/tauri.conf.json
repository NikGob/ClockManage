{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClockManage",
  "version": "0.6.0",
  "identifier": "com.nikgob.clockmanage",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClockManage",
        "url": "index.html",
        "width": 1080,
        "height": 740,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "mini",
        "title": "ClockManage — mini timer",
        "url": "mini.html",
        "width": 320,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "overlay",
        "title": "ClockManage — alarm",
        "url": "overlay.html",
        "width": 900,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NikGob",
    "shortDescription": "Study mode: blocking, timer, log",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cm-guard"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "resources": [
      "resources/android/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGRjM3NjIwMUUyOUNDOTcKUldTWHpDa2VJSGJ6RCtqWkUrZlcvMkhQNWs4L2tHTWdyT0Q0eHVLNXNwTlp4NVJHVlR3NzN5TWsK",
      "endpoints": [
        "https://github.com/NikGob/ClockManage/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
